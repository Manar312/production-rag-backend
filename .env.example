
MONGO_ROOT_USERNAME=rag_admin
MONGO_ROOT_PASSWORD=replace_with_a_strong_password
MONGO_DATABASE=rag_db

MONGO_APP_USERNAME=rag_app
MONGO_APP_PASSWORD=replace_with_a_strong_password
MONGO_APP_AUTH_DATABASE=rag_db

REDIS_URL=redis://127.0.0.1:6379/0
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/1
