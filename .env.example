QDRANT_COLLECTION=rag_chunks
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_DIMENSION=384

# Optional OpenAI-compatible LLM endpoint
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=
